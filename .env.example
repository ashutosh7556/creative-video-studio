# Copy this file to .env (same folder) and fill in your login.
# .env is gitignored, so your credentials are never committed.

# The only email/password that can sign in to the dashboard.
AUTH_EMAIL=you@example.com
AUTH_PASSWORD=change-me-please

# Optional: a long random string. If set, you stay logged in across API restarts.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
