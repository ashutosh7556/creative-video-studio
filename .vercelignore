# Never upload secrets, local data, models or build output to Vercel.
.env
.env.*
!.env.example
data/
test-artifacts/
node_modules/
**/node_modules/
**/dist/
# The Python TTS service is backend-only (needs the 350 MB model); the dashboard does not use it.
services/
assets/music/*
!assets/music/.gitkeep
**/__pycache__/
.pytest_cache/
